POSTGRES_DB=marketing_os
POSTGRES_USER=marketing_os
POSTGRES_PASSWORD=replace-with-generated-password
MARKETING_OS_DB_URL=postgresql+psycopg://marketing_os:replace-with-generated-password@postgres:5432/marketing_os
MARKETING_OS_SECRET=replace-with-at-least-32-random-bytes
MARKETING_OS_ENV=production
MARKETING_OS_TRUSTED_HOSTS=marketing.example.internal
MARKETING_OS_PROXY_HOPS=1
MARKETING_OS_BOOTSTRAP_DATA=0
